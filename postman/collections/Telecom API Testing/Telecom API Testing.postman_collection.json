    "name": "Telecom API Testing",
    "description": "StarAgile QA capstone: API Testing for Contact List Application.\nBase URL: https://thinking-tester-contact-list.herokuapp.com\nRun the requests in order 01 to 10 (or use the Collection Runner). Variables token, contactId and userEmail are set automatically by test/pre-request scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58656290",
    "_collection_link": "https://go.postman.co/collection/58656290-2d75005d-a8ca-4e5a-96ad-b022f9ea3419?source=collection_link"
  },
  "item": [
    {
      "name": "01 Add User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Unique email for every run (API requires unique emails)",
              "const email = 'leelaa.' + Date.now() + '@example.com';",
              "pm.collectionVariables.set('userEmail', email);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 (Created)', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Response contains user and token', function () {",
              "    pm.expect(body).to.have.property('token');",
              "    pm.expect(body).to.have.property('user');",
              "});",
              "",
              "pm.test('User email matches the request', function () {",
              "    pm.expect(body.user.email).to.eql(pm.collectionVariables.get('userEmail'));",
              "});",
              "",
              "// Save token for the dependent requests",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"{{userFirstName}}\",\n  \"lastName\": \"{{userLastName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
